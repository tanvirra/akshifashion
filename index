<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>আকাশী ফ্যাশন | Akashi Fashion</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        akashi: {
                            light: '#e0f2fe',
                            DEFAULT: '#0284c7',
                            dark: '#0369a1',
                            accent: '#f43f5e'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
        body { font-family: 'Hind Siliguri', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col selection:bg-akashi selection:text-white">

    <!-- Top Bar -->
    <div class="bg-akashi-dark text-white text-xs sm:text-sm py-2 px-4 text-center tracking-wide">
        <span><i class="fa-solid fa-phone-volume mr-1.5"></i> হটলাইন: ০১৯০০-০০০০০০ | ক্যাশ অন ডেলিভারি সারা বাংলাদেশে!</span>
    </div>

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('shop')">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-akashi flex items-center justify-center text-white font-bold text-xl shadow-md shadow-sky-200">আ</div>
                <div>
                    <h1 class="text-base sm:text-xl font-bold text-akashi-dark leading-tight">আকাশী ফ্যাশন</h1>
                    <span class="text-[10px] sm:text-xs text-slate-500 font-medium block -mt-0.5">প্রফেশনাল বুটিক্স ও অর্নামেন্টস</span>
                </div>
            </div>

            <!-- Dynamic Navigation Links (Only in Shop Mode) -->
            <nav id="shop-nav" class="hidden md:flex space-x-4 lg:space-x-6 text-xs lg:text-sm font-semibold text-slate-600 overflow-x-auto py-1">
                <!-- Dynamically rendered categories -->
            </nav>

            <!-- Action Buttons -->
            <div class="flex items-center space-x-2 sm:space-x-3">
                <button id="cart-btn" onclick="toggleCart()" class="relative bg-sky-50 text-akashi-dark px-3 sm:px-4 py-2 rounded-xl font-semibold text-xs sm:text-sm flex items-center hover:bg-akashi hover:text-white transition shadow-sm border border-sky-100">
                    <i class="fa-solid fa-cart-shopping mr-1.5 text-sm"></i> কার্ট 
                    <span id="cart-count" class="absolute -top-1.5 -right-1.5 bg-akashi-accent text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold border-2 border-white">0</span>
                </button>
                <button id="admin-access-btn" onclick="openAdminLoginModal()" class="bg-slate-900 text-white px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold hover:bg-slate-800 transition flex items-center shadow-sm">
                    <i class="fa-solid fa-user-shield mr-1.5 text-xs"></i> <span id="admin-btn-text">অ্যাডমিন</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- ================= BUYER / SHOP VIEW ================= -->
        <div id="shop-view" class="space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-sky-100 via-blue-50 to-indigo-100 rounded-3xl p-6 sm:p-10 lg:p-12 flex flex-col md:flex-row items-center justify-between shadow-sm border border-sky-100">
                <div class="mb-6 md:mb-0 md:w-1/2 text-center md:text-left space-y-3">
                    <span class="bg-akashi text-white text-[11px] sm:text-xs px-3.5 py-1 rounded-full uppercase tracking-wider font-bold shadow-sm">নতুন কালেকশন ২০২৬</span>
                    <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-800 leading-snug">আপনার আভিজাত্য প্রকাশ করুন আকাশী ফ্যাশনের সাথে</h2>
                    <p class="text-slate-600 text-xs sm:text-sm lg:text-base leading-relaxed">সেরা মানের ট্রেন্ডি বুটিক্স আইটেম, মার্জিত হিজাব, গহনা এবং স্টেশনারি এখন আপনার হাতে।</p>
                    <div>
                        <button onclick="document.getElementById('products-section').scrollIntoView({behavior: 'smooth'})" class="bg-akashi text-white px-6 py-3 rounded-xl text-xs sm:text-sm font-bold shadow-lg shadow-sky-200 hover:bg-akashi-dark transition transform active:scale-95">শপিং শুরু করুন <i class="fa-solid fa-arrow-right-long ml-2"></i></button>
                    </div>
                </div>
                <div class="md:w-1/2 flex justify-center">
                    <div class="w-full max-w-sm h-48 sm:h-60 bg-white/70 backdrop-blur rounded-3xl shadow-inner flex flex-col items-center justify-center border border-sky-200/60 p-6 text-center">
                        <i class="fa-solid fa-store text-5xl sm:text-6xl text-akashi mb-3"></i>
                        <span class="text-sm sm:text-base font-bold text-slate-700">১০০% অরিজিনাল কটন ও ফ্যাব্রিক</span>
                        <span class="text-xs text-slate-500 mt-1">সারা দেশে ক্যাশ অন ডেলিভারি</span>
                    </div>
                </div>
            </div>

            <!-- Products Section Header -->
            <div id="products-section" class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-3 border-b border-slate-200 gap-2">
                <h3 class="text-lg sm:text-2xl font-bold text-slate-800 flex items-center">
                    <i class="fa-solid fa-grip-vertical text-akashi mr-2"></i> জনপ্রিয় প্রোডাক্টসমূহ
                </h3>
                <div class="text-xs sm:text-sm font-semibold text-slate-500" id="product-count-text">সবগুলো আইটেম দেখানো হচ্ছে</div>
            </div>

            <!-- Product Grid (Optimized for all screen sizes from mobile to TV) -->
            <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
                <!-- Dynamic Products -->
            </div>
        </div>

        <!-- ================= ADMIN PANEL VIEW ================= -->
        <div id="admin-view" class="hidden space-y-6">
            <!-- Admin Top Navigation Bar -->
            <div class="bg-slate-900 text-white rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center space-x-3">
                    <div class="p-2.5 bg-akashi rounded-xl shadow-md">
                        <i class="fa-solid fa-sliders text-xl text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-lg sm:text-xl font-bold">অ্যাডমিন ড্যাশবোর্ড</h2>
                        <p class="text-xs text-slate-400">শপ প্রোডাক্ট ও কাস্টমার অর্ডার কন্ট্রোল প্যানেল</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2 sm:space-x-3 w-full sm:w-auto justify-end flex-wrap gap-y-2">
                    <button id="tab-btn-orders" onclick="switchAdminTab('orders')" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-akashi text-white transition shadow">
                        <i class="fa-solid fa-cart-flatbed mr-1.5"></i> অর্ডারসমূহ
                    </button>
                    <button id="tab-btn-products" onclick="switchAdminTab('products')" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 transition">
                        <i class="fa-solid fa-boxes-stacked mr-1.5"></i> প্রোডাক্ট আপলোড
                    </button>
                    <button id="tab-btn-categories" onclick="switchAdminTab('categories')" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 transition">
                        <i class="fa-solid fa-layer-group mr-1.5"></i> ক্যাটাগরি ম্যানেজমেন্ট
                    </button>
                    <button onclick="openChangePasswordModal()" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 transition" title="পাসওয়ার্ড চেঞ্জ">
                        <i class="fa-solid fa-key mr-1.5"></i> পাসওয়ার্ড
                    </button>
                    <button onclick="adminLogout()" class="px-3 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs sm:text-sm font-bold transition shadow" title="লগআউট">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>

            <!-- Dashboard Stats Summary -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <div class="bg-white border border-slate-200/80 p-4 rounded-2xl shadow-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 text-xs sm:text-sm font-semibold">মোট অর্ডার</span>
                        <div class="w-9 h-9 rounded-xl bg-sky-50 text-akashi flex items-center justify-center text-sm">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                    </div>
                    <h3 id="stat-total-orders" class="text-xl sm:text-2xl font-bold text-slate-800 mt-2">০</h3>
                </div>
                <div class="bg-white border border-slate-200/80 p-4 rounded-2xl shadow-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 text-xs sm:text-sm font-semibold">মোট বিক্রি</span>
                        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-bangladeshi-taka-sign"></i>
                        </div>
                    </div>
                    <h3 id="stat-total-sales" class="text-xl sm:text-2xl font-bold text-emerald-600 mt-2">৳০</h3>
                </div>
                <div class="bg-white border border-slate-200/80 p-4 rounded-2xl shadow-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 text-xs sm:text-sm font-semibold">পেন্ডিং অর্ডার</span>
                        <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                    <h3 id="stat-pending-orders" class="text-xl sm:text-2xl font-bold text-amber-600 mt-2">০</h3>
                </div>
                <div class="bg-white border border-slate-200/80 p-4 rounded-2xl shadow-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 text-xs sm:text-sm font-semibold">মোট প্রোডাক্ট</span>
                        <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-shirt"></i>
                        </div>
                    </div>
                    <h3 id="stat-total-products" class="text-xl sm:text-2xl font-bold text-purple-600 mt-2">০</h3>
                </div>
            </div>

            <!-- ADMIN SECTION 1: ORDERS MANAGEMENT TABLE -->
            <div id="admin-orders-section" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-3 border-b border-slate-100 gap-3">
                    <div>
                        <h3 class="text-lg sm:text-xl font-bold text-slate-800">অর্ডার ডিটেইলস ও ডেলিভারি আপডেট টেবিল</h3>
                        <p class="text-xs text-slate-500">কাস্টমারের অর্ডারকৃত পণ্যের কোড, সাইজ, কালার ও স্ট্যাটাস ট্রেকিং</p>
                    </div>
                    <!-- Order Filter -->
                    <div class="flex items-center space-x-2">
                        <span class="text-xs text-slate-500 font-semibold">ফিল্টার:</span>
                        <select id="order-status-filter" onchange="renderAdminOrders()" class="p-2 border rounded-xl text-xs bg-white font-medium focus:ring-2 focus:ring-akashi outline-none">
                            <option value="all">সব অর্ডার</option>
                            <option value="পেন্ডিং">পেন্ডিং</option>
                            <option value="ডেলিভার্ড">ডেলিভার্ড</option>
                        </select>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-left border-collapse min-w-[900px]">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 text-xs uppercase font-bold tracking-wider">
                                <th class="p-3.5">ট্র্যাকিং ID</th>
                                <th class="p-3.5">তারিখ ও সময়</th>
                                <th class="p-3.5">কাস্টমার কন্টাক্ট</th>
                                <th class="p-3.5">ঠিকানা</th>
                                <th class="p-3.5">অর্ডার ডিটেইলস (কোড, সাইজ, কালার, মূল্য)</th>
                                <th class="p-3.5">মোট (৳)</th>
                                <th class="p-3.5">স্ট্যাটাস</th>
                                <th class="p-3.5 text-center">ডেলিভারি ট্র্যাকিং</th>
                            </tr>
                        </thead>
                        <tbody id="admin-orders-table" class="text-xs sm:text-sm divide-y divide-slate-100">
                            <!-- Dynamic Orders -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ADMIN SECTION 2: PRODUCTS MANAGEMENT (FILE UPLOAD / EDIT) -->
            <div id="admin-products-section" class="hidden space-y-6">
                <!-- Add New Product Form -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6" id="product-form-container">
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100 flex items-center justify-between">
                        <span id="form-title-text"><i class="fa-solid fa-cloud-arrow-up text-akashi mr-2"></i> প্রোডাক্ট আপলোড করুন (ছবি সহ)</span>
                        <span id="edit-badge" class="hidden text-xs bg-amber-100 text-amber-700 px-3 py-1 rounded-full font-bold">এডিট মোড সক্রিয়</span>
                    </h3>
                    <form id="product-form" onsubmit="handleProductSubmit(event)" class="space-y-4">
                        <input type="hidden" id="prod-edit-id">

                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">প্রোডাক্ট কোড / SKU *</label>
                                <input type="text" id="prod-code" required class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="যেমন: AK-101">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">প্রোডাক্টের নাম *</label>
                                <input type="text" id="prod-name" required class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="যেমন: প্রিমিয়াম লিনেন থ্রি-পিস">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">ক্যাটাগরি *</label>
                                <select id="prod-category" required class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none bg-white">
                                    <!-- Dynamic categories options -->
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">মূল্য (টাকা) *</label>
                                <input type="number" id="prod-price" required min="1" class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="যেমন: ১২৫০">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">সাইজসমূহ (কমা দিয়ে আলাদা করুন)</label>
                                <input type="text" id="prod-sizes" class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="যেমন: Free Size, M, L, XL">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">কালার কম্বিনেশন (কমা দিন)</label>
                                <input type="text" id="prod-colors" class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="যেমন: নীল, লাল, কালো">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">স্টক স্ট্যাটাস</label>
                                <select id="prod-stock" class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none bg-white">
                                    <option value="In Stock">স্টকে আছে (In Stock)</option>
                                    <option value="Stock Out">স্টক শেষ (Stock Out)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Image File Upload Drop Zone -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">প্রোডাক্টের ছবি আপলোড/পরিবর্তন করুন (মোবাইল/কম্পিউটার থেকে) *</label>
                            <div id="drop-zone" onclick="document.getElementById('prod-file-input').click()" class="border-2 border-dashed border-sky-300 bg-sky-50/50 hover:bg-sky-50 rounded-2xl p-4 text-center cursor-pointer transition flex flex-col items-center justify-center min-h-[110px]">
                                <i class="fa-solid fa-cloud-arrow-up text-3xl text-akashi mb-2"></i>
                                <p class="text-xs sm:text-sm font-semibold text-slate-700">ছবি ড্রপ করুন অথবা ফাইল সিলেক্ট করতে ক্লিক করুন</p>
                                <p class="text-[11px] text-slate-400 mt-0.5">JPG, PNG, WEBP ফরম্যাট সমর্থিত</p>
                                <input type="file" id="prod-file-input" accept="image/*" class="hidden" onchange="previewImageFile(event)">
                            </div>

                            <!-- Preview Box -->
                            <div id="image-preview-container" class="hidden mt-3 flex items-center space-x-3 bg-slate-100 p-2.5 rounded-xl border">
                                <img id="image-preview" class="w-16 h-16 object-cover rounded-lg border bg-white" src="" alt="Preview">
                                <div class="flex-1">
                                    <p id="preview-filename" class="text-xs font-bold text-slate-700 truncate"></p>
                                    <span class="text-[10px] text-emerald-600 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i> ছবি নির্বাচিত হয়েছে</span>
                                </div>
                                <button type="button" onclick="clearSelectedImage()" class="text-rose-500 text-sm px-2 hover:bg-rose-50 p-1.5 rounded-lg transition"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">প্রোডাক্টের বিবরণ *</label>
                            <textarea id="prod-desc" required rows="2" class="w-full p-2.5 border rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-akashi outline-none" placeholder="কাপড়ের কোয়ালিটি, এমব্রয়ডারি ওয়ার্ক এবং অন্যান্য বৈশিষ্ট্য লিখুন"></textarea>
                        </div>

                        <div class="flex justify-end space-x-3 pt-2">
                            <button type="button" onclick="resetProductForm()" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-bold hover:bg-slate-300">রিসেট/বাতিল</button>
                            <button type="submit" id="save-prod-btn" class="px-6 py-2 bg-akashi text-white rounded-xl text-xs sm:text-sm font-bold hover:bg-akashi-dark shadow-md transition">প্রোডাক্ট সেভ করুন</button>
                        </div>
                    </form>
                </div>

                <!-- Products Inventory Table -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6">
