        function handleProductSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('prod-edit-id').value;
            const code = document.getElementById('prod-code').value;
            const name = document.getElementById('prod-name').value;
            const category = document.getElementById('prod-category').value;
            const price = parseFloat(document.getElementById('prod-price').value);
            const sizesStr = document.getElementById('prod-sizes').value;
            const colorsStr = document.getElementById('prod-colors').value;
            const stock = document.getElementById('prod-stock').value;
            const desc = document.getElementById('prod-desc').value;

            const image = tempSelectedImageData || 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=600&auto=format&fit=crop&q=80';

            const sizes = sizesStr ? sizesStr.split(',').map(s => s.trim()) : ['Standard'];
            const colors = colorsStr ? colorsStr.split(',').map(c => c.trim()) : ['Standard'];

            if(editId) {
                const index = products.findIndex(p => p.id == editId);
                if(index !== -1) {
                    const currentImg = tempSelectedImageData || products[index].image;
                    products[index] = { id: parseInt(editId), code, name, category, price, sizes, colors, image: currentImg, stock, desc };
                }
                alert('প্রোডাক্ট তথ্য সফলভাবে আপডেট করা হয়েছে!');
            } else {
                const newId = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;
                products.push({ id: newId, code, name, category, price, sizes, colors, image, stock, desc });
                alert('নতুন প্রোডাক্ট সফলভাবে সেভ করা হয়েছে!');
            }

            resetProductForm();
            renderAdminProducts();
            renderProducts(products);
            updateDashboardStats();
        }

